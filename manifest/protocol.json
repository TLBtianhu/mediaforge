  "events": {
    "_comment": [
      "流式事件的唯一词表：<域>.<动词>，域是 task（任务）或 asset（资产获取）。",
      "终态只有一个名字 task.result（原 task.done 已收敛进来）。",
      "命令结果型事件（models / env_info …）不在此列，它们与命令同名。",
      "emit() 只发这里有的名字；scripts/check-architecture.py 会拒绝 task_* / download_* 这类历史写法。",
      "终态事件是 canonical 的子集：任务或资产到此不再产生进度。"
    ],
    "canonical": [
      "task.started",
      "task.stage",
      "task.progress",
      "task.log",
      "task.result",
      "task.cancelled",
      "asset.started",
      "asset.stage",
      "asset.progress",
      "asset.log",
      "asset.done"
    ],
    "terminal": [
      "task.result",
      "task.cancelled",
      "asset.done"
    ]
  },
  "execution": {
    "_comment": [
      "执行侧清单：哪些命令需要 bootstrap 解释器、哪些是 Rust 原生入口。",
      "worker 项必须能在 domains 的 command 里找到；native 项不在 worker 协议里。",
      "resultJobs 是“结果任务”的分类：commands 为 worker 命令，operations 为经 media 路由的操作名。",
      "outputScope 声明需要输出临时作用域的命令/操作；backgroundResult 声明必须有后台结果代理的命令。",
      "bootstrap.withoutRuntime 是没有激活运行时也允许跑的查询/下载命令；updatesRuntime 是会替换运行时并把 bootstrap 使用者排除在外的命令。"
    ],
    "bootstrap": {
      "worker": [
        "health",
        "runtime_info",
        "runtime_env_sizes",
        "runtime_core_versions",
        "install_runtime",
        "activate_runtime",
        "delete_runtime"
      ],
      "native": [
        "update_runtime_core"
      ],
      "withoutRuntime": [
        "media_library",
        "list_models",
        "env_info",
        "model_hub",
        "model_download"
      ],
      "updatesRuntime": [
        "update_runtime_core",
        "manage_plugin",
        "activate_runtime",
        "delete_runtime",
        "install_runtime"
      ]
    },
    "resultJobs": {
      "commands": [
        "infer",
        "infer_workflow",
        "audio_tools",
        "media_tool",
        "run_operation",
        "export_editor_mix"
      ],
      "operations": [
        "media_image",
        "media_video",
        "media_workflow",
        "media_convert"
      ]
    },
    "outputScope": {
      "commands": [
        "run_operation"
      ],
      "audioToolCommands": [
        "audio_tools"
      ],
      "operations": [
        "convert",
        "merge",
        "slicer"
      ]
    },
    "backgroundResult": [
      "audio_tools",
      "export_editor_mix",
      "manage_plugin",
      "run_operation"
    ]
  }
}
