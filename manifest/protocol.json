  "events": {
    "_comment": "规范事件名 → 历史事件的映射。emit() 在边界处把历史名翻译成规范名。",
    "canonical": [
      "task.started",
      "task.progress",
      "task.log",
      "task.result",
      "task.failed",
      "task.cancelled",
      "asset.progress",
      "asset.done",
      "asset.failed",
      "runtime.state",
      "catalog.state",
      "app.state"
    ]
  },
  "emitAliases": {
    "audio_tool_progress": "task.progress",
    "audio_tool_result": "task.result",
    "media_image_result": "task.result",
    "media_video_result": "task.result"
