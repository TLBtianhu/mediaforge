node_modules/
.pnpm-store/

# Frontend build
dist/

# Tauri / Rust build
src-tauri/target/
src-tauri/target/**
src-tauri/gen/schemas/linux-schema.json

# Python cache
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.python-version
.venv/
venv/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local AI tooling state
.claude/
.serena/
.playwright-mcp/
