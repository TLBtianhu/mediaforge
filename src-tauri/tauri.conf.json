{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaForge",
  "version": "0.0.19",
  "identifier": "studio.mediaforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MediaForge",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/.pymss-studio/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm"
    ],
    "resources": [
      "resources/plugin-sdk/*",
      "../python/*.py",
      "../python/*.json",
      "../python/*.txt",
      "../python/audio_tools/**/*.py",
      "../python/audio_tools/LICENSE.audio-slicer",
      "../python/media_ops/**/*.py",
      "../python/media_ops/**/*.json",
      "../python/game/**/*.py",
      "../python/game/**/*.txt",
      "../python/game/LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0.0",
      "entitlements": "entitlements.plugins.plist"
    },
    "publisher": "TheSmallHanCat"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGOTFCNEFFRTRGNUJBN0EKUldSNnV2WGtyclNSZjc4Y0Z4aDVGSUNTV0xlSkgwczdhSW9jenNkQXgrQmVZOTIrVVVhWEpLYW4K",
      "endpoints": []
    }
  }
}
